[sub_resource type="Resource" id="Resource_ig3ba"]
script = ExtResource("2_pynqw")
person = 9
text = "Far-thee-well, oh greatest of acquantances!"
post_effects = Array[ExtResource("1_pv380")]([SubResource("Resource_a4dhq")])
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_bfqwa"]
script = ExtResource("2_pynqw")
person = 9
text = "Now please, forgive me, but I must depart. There's a one way ticket to a tropical island calling my name."
default_next_line = SubResource("Resource_ig3ba")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_bvje8"]
script = ExtResource("2_pynqw")
person = 9
text = "I feel astounding! Oh thank you so much Mr. Reaper, and you as well dear Ghost."
default_next_line = SubResource("Resource_bfqwa")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_ih6e3"]
script = ExtResource("2_pynqw")
person = 11
text = "Say Ghost, would you like to have a little jaunt home with me?"
default_next_line = SubResource("Resource_bvje8")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_occyl"]
script = ExtResource("2_pynqw")
person = 11
text = "Vacation is fun and all, but what can I say. It feels good to be needed."
default_next_line = SubResource("Resource_ih6e3")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_uarxn"]
script = ExtResource("2_pynqw")
person = 11
text = "Ahh, it feels good to get back in the swing of things."
default_next_line = SubResource("Resource_occyl")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_j287u"]
script = ExtResource("2_pynqw")
person = 11
text = "And, that should about do it. Enjoy aliving again, dude. Be sure to eat a veggie burger for me."
default_next_line = SubResource("Resource_uarxn")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_pv380"]
script = ExtResource("2_pynqw")
person = 11
text = "*SCHHIINGGG*"
default_next_line = SubResource("Resource_j287u")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_f0c3g"]
script = ExtResource("2_pynqw")
person = 11
text = "Alright, bud, just stick out your chompers, yep just like that..."
default_next_line = SubResource("Resource_pv380")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_mqu8f"]
