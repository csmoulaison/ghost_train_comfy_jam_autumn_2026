[sub_resource type="Resource" id="Resource_ufu2b"]
script = ExtResource("2_0tjwa")
person = 2
text = "I have a very lucrative stand at the Farmer's Market where I sell produce. That's why I'm here, see, scouting out some product!"
default_next_line = SubResource("Resource_j287u")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_v0f16"]
script = ExtResource("2_0tjwa")
person = 2
text = "Well, ruffle my feathers, don't you look like the entrepreneurial sort, and with a train, to boot. How's about I make you a business proposition?"
default_next_line = SubResource("Resource_ufu2b")
metadata/_custom_type_script = "uid://cek7638wfa72g"

