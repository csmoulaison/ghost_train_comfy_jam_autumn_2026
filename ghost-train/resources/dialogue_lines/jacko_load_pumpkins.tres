[sub_resource type="Resource" id="Resource_jey4n"]
script = ExtResource("2_is2u6")
person = 3
text = "Say... Ghost. If you happen to find any of the whippersnappers, you'll bring them back on over to me, won't you?"
default_next_line = SubResource("Resource_ionxr")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_j287u"]
script = ExtResource("2_is2u6")
person = 3
text = "Hm... Seems I've lost track of the little devils. No matter. The vine doesn't crawl far from the patch. I'm sure they're fine but..."
default_next_line = SubResource("Resource_jey4n")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_qi4tn"]
script = ExtResource("2_is2u6")
person = 3
text = "Now then, where'd those rascals run off to?"
default_next_line = SubResource("Resource_j287u")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_csa5p"]
