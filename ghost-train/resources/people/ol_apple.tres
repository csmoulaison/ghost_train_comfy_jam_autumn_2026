person = 12
text = "Hmph. I guess I'll have to share my autumn victuals with a more appreciative guest."
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_4mbvd"]
script = ExtResource("1_s80ha")
person = 12
text = "You were kind enough to bring me some reading material. Take as many apples as you like, small apparition."
