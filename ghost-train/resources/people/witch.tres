[sub_resource type="Resource" id="Resource_giqpx"]
script = ExtResource("5_cxhng")
flag_true = 18
metadata/_custom_type_script = "uid://duou3b1bvu86e"

[sub_resource type="Resource" id="Resource_nhob2"]
script = ExtResource("1_6vsfv")
person = 5
text = "I'm just along for the ride today."
conditions = Array[ExtResource("5_cxhng")]([SubResource("Resource_giqpx")])
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_uopof"]
script = ExtResource("5_cxhng")
person_on_train = 5
metadata/_custom_type_script = "uid://duou3b1bvu86e"

[sub_resource type="Resource" id="Resource_k5410"]
script = ExtResource("1_6vsfv")
person = 5
text = " I remember racing trains on my steam-powered broom in my youth. Oh, how time flies."
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_cxhng"]
script = ExtResource("1_6vsfv")
person = 5
text = "Man, nothing beats trains."
default_next_line = SubResource("Resource_k5410")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_7v5ef"]
script = ExtResource("1_6vsfv")
person = 5
text = "You feel the shake of the engine? The squeak of wheels sliding across metal? The aroma of engine grease?"
conditions = Array[ExtResource("5_cxhng")]([SubResource("Resource_uopof")])
default_next_line = SubResource("Resource_cxhng")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_fb12x"]
script = ExtResource("1_6vsfv")
person = 5
text = "So if you're struggling to fulfill your dreams, than you're doing it right."
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_r1w0p"]
script = ExtResource("1_6vsfv")
person = 5
text = "Lemme share a little secret my ol' grandma used to tell me.  Nothing worth doing is easy."
default_next_line = SubResource("Resource_fb12x")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_5gqha"]
script = ExtResource("1_6vsfv")
person = 5
text = "There's no room on your train!"
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_j287u"]
script = ExtResource("1_6vsfv")
person = 5
text = "Talk to me if you really want this cat to purr! I have a couple of brooms to shake at it."
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_uh2qv"]
script = ExtResource("1_6vsfv")
person = 5
text = "Not only that, but I can use some of the old boxcars around here to upgrade your train."
default_next_line = SubResource("Resource_j287u")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_uvqje"]
script = ExtResource("1_6vsfv")
person = 5
text = "I build tracks lickety split. With a few coins my way, I can build out your connections between stops."
default_next_line = SubResource("Resource_uh2qv")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_4pxqi"]
script = ExtResource("1_6vsfv")
person = 5
text = "Now, I told you I'd make it worth you while so I won't skimp on the details."
default_next_line = SubResource("Resource_uvqje")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_p46rs"]
script = ExtResource("4_p8uhu")
offboard_person = 5
metadata/_custom_type_script = "uid://ds5odfukpyq25"

[sub_resource type="Resource" id="Resource_6vsfv"]
script = ExtResource("1_6vsfv")
person = 5
text = "Ghost, you've done my heart good giving me a ride. You've got one heck of a train on your hands. A beautiful piece of machinery."
pre_effects = Array[ExtResource("4_p8uhu")]([SubResource("Resource_p46rs")])
default_next_line = SubResource("Resource_4pxqi")
metadata/_custom_type_script = "uid://cek7638wfa72g"

