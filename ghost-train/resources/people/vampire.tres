metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_k0awt"]
script = ExtResource("1_ml87m")
person = 9
text = "....."
default_next_line = SubResource("Resource_jbut4")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_hmb2b"]
script = ExtResource("1_ml87m")
person = 9
text = "But, tis folly. There are no vampiric dental practices around here nor any experts on afterlife affairs. Tis pointless, I'm afraid."
default_next_line = SubResource("Resource_k0awt")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_2a3ai"]
script = ExtResource("1_ml87m")
person = 9
text = "Oh what I wouldn't give to nap the day away."
default_next_line = SubResource("Resource_hmb2b")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_0ys1a"]
script = ExtResource("1_ml87m")
person = 9
text = "I get the worst sunburns. Blood has a very boring, iron flavor. My teeth keep piercing my tongue. I don't even sleep!"
default_next_line = SubResource("Resource_2a3ai")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_t21jq"]
script = ExtResource("1_ml87m")
person = 9
text = "Sure, I've enjoyed a few centuries to pursue my greatest passions, but at what cost?"
default_next_line = SubResource("Resource_0ys1a")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_56j57"]
script = ExtResource("1_ml87m")
person = 9
text = "Not that its anything you care to know but I've grown rather tired of immortality."
default_next_line = SubResource("Resource_t21jq")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_qp1xr"]
script = ExtResource("1_ml87m")
person = 9
text = "*sigh* Oh. Apologies. I was just lamenting."
default_next_line = SubResource("Resource_56j57")
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_o0cry"]
