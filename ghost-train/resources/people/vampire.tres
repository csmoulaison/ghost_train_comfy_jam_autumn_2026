metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_wrco8"]
script = ExtResource("1_ml87m")
person = 9
text = "Ah. I apologize for misunderstanding. Must be wishful thinking."
