metadata/_custom_type_script = "uid://ds5odfukpyq25"

[sub_resource type="Resource" id="Resource_0bobq"]
script = ExtResource("1_ml87m")
person = 9
text = "A bitter taste, the only taste. Oh how I doth miss the sweet juice of an apple."
conditions = Array[ExtResource("3_ke5tb")]([SubResource("Resource_1r8be")])
post_effects = Array[ExtResource("2_17gf0")]([SubResource("Resource_o0cry")])
