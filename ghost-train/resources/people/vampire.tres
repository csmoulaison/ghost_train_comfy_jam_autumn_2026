metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_jbut4"]
script = ExtResource("1_ml87m")
person = 9
text = "Are you suggesting I board your locomotive? "
prompt_text = "Board the vampire?"
accept_effects = Array[ExtResource("2_17gf0")]([SubResource("Resource_j287u")])
default_accept_line = SubResource("Resource_ct4ee")
