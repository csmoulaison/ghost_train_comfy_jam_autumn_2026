[sub_resource type="Resource" id="Resource_l8mkx"]
script = ExtResource("1_ml87m")
person = 9
text = "I shouldn't burden you with my sad stories. Carry on your duties, conductor."
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_a7ovh"]
