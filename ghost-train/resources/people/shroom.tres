[sub_resource type="Resource" id="Resource_os2wj"]
script = ExtResource("1_luhrd")
person = 10
text = "Not many venture into my Fungi Forest. Which is a shame, this place used to be the bee's knees. Everyone flocked here for my shrooms."
default_next_line = SubResource("Resource_1ax80")
metadata/_custom_type_script = "uid://cek7638wfa72g"

