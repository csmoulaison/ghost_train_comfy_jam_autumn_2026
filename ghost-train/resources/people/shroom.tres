[sub_resource type="Resource" id="Resource_hysau"]
script = ExtResource("1_luhrd")
person = 10
text = "I am in no rush. But if I know Witcherly, she's very impatient. I would not keep her waiting."
metadata/_custom_type_script = "uid://cek7638wfa72g"

[sub_resource type="Resource" id="Resource_4lynm"]
script = ExtResource("1_luhrd")
person = 10
text = "Take me to her yard."
